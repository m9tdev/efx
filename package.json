{
  "name": "verrex-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter verrex-demo dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "size": "pnpm -r build 2>&1 | grep -E 'dist/.*\\.(js|html)' | sed 's/^.*demo build: //'",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "oxlint && node scripts/vx-oxc.mjs lint",
    "lint:fix": "oxlint --fix && node scripts/vx-oxc.mjs lint:fix",
    "format": "oxfmt . && node scripts/vx-oxc.mjs format",
    "format:check": "oxfmt --check . && node scripts/vx-oxc.mjs format:check"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.3.0"
}
