{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "unicorn/no-useless-spread": "off",
    "require-yield": "off"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["**/*.test-d.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
