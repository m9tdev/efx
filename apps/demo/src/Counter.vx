import { Component } from "@verrex/core"
import { Atom } from "effect/unstable/reactivity"

/**
 * Small reactive component using an `Atom` cell for local state.
 *
 * `Atom.make(0)` is the default cell (a `Writable`; writes are `Atom.set` /
 * `Atom.update` Effects, returned straight from the handler). The `count`
 * atom is interpolated directly as a child — `h()` emits a `View.Reactive`
 * IR node when it sees an `Atom` in child position. On update, only the
 * surrounding text node re-renders.
 *
 * Inferred type: `Effect<View, never, AtomRegistry>`
 *   — the handler's `Atom.update` needs the registry; `mount` owns one and
 *   discharges it.
 */
export const Counter = Component.make(function* () {
  const count = Atom.make(0)

  return yield* (
    <div class="counter">
      <button onclick={() => Atom.update(count, (n) => n + 1)}>+</button>
      <span class="count"> clicks: {count} </span>
    </div>
  )
})
