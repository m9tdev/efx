import { Cause, Data, Effect } from "effect"
import { Catch, Component } from "@verrex/core"
import { HttpError } from "./services.ts"

// A local tagged error so the failure has a real shape in `Cause.pretty`.
class BoomError extends Data.TaggedError("BoomError")<{
  readonly why: string
}> {}

// catch-all subject: renders fine; its button's `onclick` returns a failing
// Effect, which — post-mount, with no E channel to land on — is routed to the
// nearest boundary instead of being dropped.
const Crasher = Component.make(function* () {
  return yield* (
    <div class="crasher">
      <p>Works fine — until you push the button.</p>
      <button
        class="crash"
        onclick={() =>
          Effect.fail(new BoomError({ why: "you pushed the button" }))
        }
      >
        crash me
      </button>
    </div>
  )
})

// tag-map subject: a flaky request. ~50% of attempts fail (at construction) with
// a random tagged error — the kind a tag-map handler routes on and unwraps — and
// the rest succeed. So clicking "retry" visibly re-runs the boundary and may
// recover (or surface a different error).
const STATUSES = [500, 503, 429, 404, 418]
const BadRequest = Component.make(function* () {
  if (Math.random() < 0.5) {
    const status = STATUSES[Math.floor(Math.random() * STATUSES.length)]!
    yield* Effect.fail(new HttpError({ status, message: "request failed" }))
  }
  // Even on success the subtree stays live — its button fails with an HttpError on
  // click, which the SAME tag-map catches (a live failure, not just construction).
  return yield* (
    <div class="ok">
      <p>request succeeded ✓</p>
      <button
        class="crash"
        onclick={() =>
          Effect.fail(new HttpError({ status: 500, message: "crashed live" }))
        }
      >
        crash it
      </button>
    </div>
  )
})

/**
 * `Catch` — the view-level error boundary, mirroring Effect's `catch*`. Two forms,
 * both shown here:
 *
 *  - **catch-all** — a function handler recovers *any* failure (it gets the full
 *    `Cause`). Here it catches the crash button's live Effect; `reset` re-runs the
 *    child (the button works again).
 *  - **tag-map** — an object of `{ Tag: handler }` routes by tag and hands each
 *    handler the *unwrapped* error (`e.status`). Only the listed tags are caught;
 *    anything else flows out to a parent boundary, narrowing the channel.
 *
 * Inferred type: `Effect<View, never, Scope>` — `Scope` is each boundary's own
 * contribution (it forks its reset/report loop into the enclosing scope). `mount`
 * requires every error discharged, so a *forgotten* boundary is a compile error
 * that names the unhandled error.
 */
export const CatchDemo = Component.make(function* () {
  return yield* (
    <section class="catch-demo">
      {/* catch-all (function): one fallback for any failure */}
      <Catch
        Failure={(cause, reset) => (
          <div class="boundary-fallback">
            <p class="caught">catch-all caught:</p>
            <pre class="cause">{Cause.pretty(cause)}</pre>
            <button class="reset" onclick={reset}>
              reset
            </button>
          </div>
        )}
      >
        <Crasher />
      </Catch>

      {/* tag-map (object): route by tag; handler gets the unwrapped error */}
      <Catch
        HttpError={(e, reset) => (
          <div class="boundary-fallback">
            <p class="caught">
              caught HttpError {e.status}: {e.message}
            </p>
            <button class="retry" onclick={reset}>
              retry
            </button>
          </div>
        )}
      >
        <BadRequest />
      </Catch>
    </section>
  )
})
