import { Component, For } from "@verrex/core"
import { AtomRef } from "effect/unstable/reactivity"

interface Todo {
  readonly text: string
  readonly done: boolean
}

/**
 * One row. Reads from a single item ref; toggling `done` updates only this
 * row, not the rest of the list (because the framework's reactive bindings
 * subscribe per-ref). `remove` is passed in so the row needn't reach for the
 * collection — that lives inside `Todos`.
 */
const TodoRow = Component.make(function* (props: {
  readonly item: AtomRef.AtomRef<Todo>
  readonly remove: () => void
}) {
  const ref = props.item
  const toggle = () => ref.update((t) => ({ ...t, done: !t.done }))

  // A JSX expression that reads a ref/atom uses `get(...)`: the compiler
  // lowers the expression to `h.reader(() => …)`, a derived the renderer
  // subscribes to. `ref.prop("text")` is a per-field `ReadonlyRef`, dropped
  // straight in as a child.
  return yield* (
    <li class={get(ref).done ? "done" : ""}>
      <button class="toggle" onclick={toggle}>
        {get(ref).done ? "✓" : "·"}
      </button>
      <span class="text">{ref.prop("text")}</span>
      <button class="remove" onclick={props.remove}>
        ×
      </button>
    </li>
  )
})

/**
 * The list. State lives *inside* the component, so recreating it (the demo's
 * reset button) starts from the initial todos again. `<For each={todos}>`
 * over an `AtomRef.Collection` renders one row per item ref — a keyed
 * `View.List` IR node; `mount` reconciles rows by ref identity on add/remove.
 */
export const Todos = Component.make(function* () {
  // Reactive collection — each item is wrapped in its own AtomRef so per-row
  // updates don't tear down the whole list.
  const todos = AtomRef.collection<Todo>([
    { text: "build a UI framework", done: true },
    { text: "use it for something", done: false },
    { text: "write a blog post", done: false },
  ])
  const addTodo = () => todos.push({ text: "new todo", done: false })
  const remaining: AtomRef.ReadonlyRef<number> = todos.map((items) => {
    let n = 0
    for (const ref of items) if (!ref.value.done) n++
    return n
  })

  return yield* (
    <div class="todos">
      <div class="controls">
        <button onclick={addTodo}>+ add todo</button>
        <span class="remaining">{remaining} remaining</span>
      </div>
      <ul>
        <For each={todos}>
          {(item) => <TodoRow item={item} remove={() => todos.remove(item)} />}
        </For>
      </ul>
    </div>
  )
})
