import { Cause, Data, Effect } from "effect"
import { Atom } from "effect/unstable/reactivity"
import { atom, Catch, Component, On } from "@verrex/core"
import { Http, type User } from "./services.ts"

/**
 * Demo-local second error tag: the per-tag choice of error home needs ≥2 tags
 * so one can be handled at the leaf while the other rides the residual.
 */
class RateLimited extends Data.TaggedError("RateLimited")<{
  readonly retryAfterMs: number
}> {}

/**
 * Failure homes (step 08) — **`On` picks where
 * each error lives, per call site and per tag** — built on **`atom`**: each
 * block's data is an `Atom<AsyncResult<User, HttpError | RateLimited>>`
 * created in the component body, OUTSIDE the boundaries, then rendered via
 * `Atom.map`. The data outlives the views: an escalated block's atom keeps
 * tracking `userId` (`get(userId)` in its create fn) and can be refreshed
 * from anywhere — the spam button is just `Atom.refresh(tagUser)` ×3, no
 * synthetic dep tricks.
 *
 * **Tag block** (top): the fetch can fail with `HttpError | RateLimited`.
 * - `HttpError` is handled **at the leaf** (`.onErrorTag("HttpError", …)`):
 *   the 404 banner renders in place; picking another id refetches and
 *   recovers with no boundary involved, and the banner's `retry` is
 *   `Atom.refresh(tagUser)` — re-runs the same fetch, the waiting arm shows
 *   while it's in flight.
 * - `RateLimited` is *not* handled there, so `.onFailure(Effect.failCause)`
 *   escalates the residual — the builder narrows `E` like `catchTag`, so the
 *   emitted Effect is `Effect<never, RateLimited>` and the fold puts it on
 *   `View<RateLimited>` — to the page-level `Catch`, whose own tag map
 *   unwraps it (`e.retryAfterMs` is typed). Deleting that `Catch` is a
 *   compile error naming `RateLimited`, and only `RateLimited`.
 *
 * **Open block** (bottom): the SAME data with no leaf handling — every
 * failure rides `View<HttpError | RateLimited>` to its catch-all `Catch`.
 * Deleting that `Catch` is a compile error naming the full union.
 *
 * **Boundary retries compose `Atom.refresh` + `reset`**: `reset` alone
 * re-renders the atom's CURRENT state (the data outlives the subtree — a
 * still-failed atom would just re-escalate), so the banners' retry buttons
 * run `Atom.refresh(x)` and then `reset()`.
 *
 * **The rate limit is real, and the request log narrates it**: a
 * sliding-window limiter on the fake endpoint allows 2 requests/second
 * ACROSS BOTH ATOMS. Every request logs its budget verdict (`sent (n/2
 * this second)` / `→ 429`), its `← 200/404` outcome, and `← interrupted`
 * when a newer refetch took over. Both atoms track `userId`, so an id
 * click always costs two requests — watch the log.
 *
 * Inferred type: `Effect<View, never, Http | AtomRegistry | Scope>`
 */
export const AsyncEscalate = Component.make(function* () {
  const userId = Atom.make("42")
  const http = yield* Http

  // The request log: newest line first, capped. A plain reactive text cell —
  // the whole story of the limiter told by the demo itself.
  const reqLog = Atom.make("")
  let seq = 0
  const logLine = (line: string) =>
    Atom.update(reqLog, (cur) =>
      [line, ...cur.split("\n")].slice(0, 6).join("\n"),
    )

  // Sliding-window rate limiter: at most LIMIT request creations per WINDOW,
  // shared by both atoms (it guards the endpoint, not the consumer). Runs in
  // fetchUser's synchronous prefix — request-creation time, the atom forks
  // its fiber synchronously — so every refetch (dep change, retry, spam)
  // counts exactly once, interrupted or not.
  const WINDOW_MS = 1000
  const LIMIT = 2
  const stamps: Array<number> = []
  const fetchUser = Effect.fn(function* (id: string) {
    const now = Date.now()
    while (stamps.length > 0 && now - (stamps[0] ?? now) >= WINDOW_MS)
      stamps.shift()
    if (stamps.length >= LIMIT) {
      const retryAfterMs = WINDOW_MS - (now - (stamps[0] ?? now))
      yield* logLine(
        `#${++seq} GET /users/${id} → 429 rate-limited, slot free in ${retryAfterMs}ms`,
      )
      return yield* Effect.fail(new RateLimited({ retryAfterMs }))
    }
    stamps.push(now)
    const n = ++seq
    yield* logLine(
      `#${n} GET /users/${id} — sent (${stamps.length}/${LIMIT} this second)`,
    )
    return yield* http.getUser(id).pipe(
      Effect.tap((user: User) => logLine(`#${n} ← 200 ${user.name}`)),
      Effect.tapError((e) => logLine(`#${n} ← ${e.status} ${e.message}`)),
      Effect.onInterrupt(() =>
        logLine(`#${n} ← interrupted (newer request took over)`),
      ),
    )
  })

  // The atoms: one fetch loop per block, both tracking userId, both living
  // in the COMPONENT scope — boundaries below swap views, never the data.
  const tagUser = yield* atom((get) => fetchUser(get(userId)))
  const openUser = yield* atom((get) => fetchUser(get(userId)))
  // Spam = three manual refreshes of the CURRENT id on the top atom: the
  // third (or earlier, right after a click) exceeds 2 req/s → a real 429.
  // A handler's synchronous prefix is batched (three refreshes would coalesce
  // into one recompute), so yield between them.
  const spam = () =>
    Effect.gen(function* () {
      for (let i = 0; i < 3; i++) {
        yield* Atom.refresh(tagUser)
        yield* Effect.yieldNow
      }
    })
  // Boundary retry: refresh the data, THEN re-render the subtree.
  const retry = (x: Atom.Atom<unknown>, reset: () => void) =>
    Effect.andThen(Atom.refresh(x), Effect.sync(reset))

  return yield* (
    <div class="async-escalate">
      <div class="controls">
        <button onclick={() => Atom.set(userId, "42")}>Ada (42)</button>
        <button onclick={() => Atom.set(userId, "7")}>Grace (7)</button>
        <button onclick={() => Atom.set(userId, "999")}>Bad id</button>
        <button class="spam" onclick={spam}>
          spam ×3
        </button>
        <span class="budget-note">
          fake API allows 2 req/s — an id click fetches once per block; spam
          re-requests the top block
        </span>
      </div>
      <pre class="req-log">{reqLog}</pre>
      <Catch
        Failure={{
          // The residual — View<RateLimited> — lands here, unwrapped + typed.
          // Over an atom, reset alone re-renders the still-failed state:
          // compose refresh + reset so retry re-fetches AND re-renders.
          RateLimited: (e, reset) => (
            <div class="boundary-fallback page-fallback">
              <p class="caught">page boundary caught: RateLimited</p>
              <p class="rate-msg">rate limited — retry in {e.retryAfterMs}ms</p>
              <button class="retry" onclick={() => retry(tagUser, reset)}>
                retry
              </button>
            </div>
          ),
        }}
      >
        <section class="content">
          <On
            value={tagUser}
            Waiting={() => <span class="loading">loading…</span>}
            Success={(s) => (
              <div class="user-card">
                <strong>{s.value.name}</strong>
                {s.value.bio && <p class="bio">{s.value.bio}</p>}
              </div>
            )}
            // Handled at the leaf: the atom stays live, so another id
            // recovers without any reset; retry is Atom.refresh(tagUser).
            // Anything else (RateLimited) BUBBLES — On escalates
            // unhandled failures by default: View<RateLimited>.
            Failure={{
              HttpError: (e) => (
                <div class="leaf-fallback">
                  <p class="leaf-msg">
                    handled at the leaf — HttpError {e.status}: {e.message}
                  </p>
                  <button
                    class="leaf-retry"
                    onclick={() => Atom.refresh(tagUser)}
                  >
                    retry
                  </button>
                </div>
              ),
            }}
          />
        </section>
      </Catch>
      <p class="contrast-label">
        same fetch, open form — nothing handled at the leaf, every failure
        escalates:
      </p>
      <Catch
        Failure={(cause, reset) => (
          <div class="boundary-fallback open-fallback">
            <p class="caught">catch-all caught:</p>
            <pre class="cause">{Cause.pretty(cause)}</pre>
            <button class="retry" onclick={() => retry(openUser, reset)}>
              retry
            </button>
          </div>
        )}
      >
        <section class="contrast">
          {/* No Failure arm at all: EVERY failure bubbles to the catch-all. */}
          <On
            value={openUser}
            Waiting={() => <span class="loading">loading…</span>}
            Success={(s) => <strong class="open-ok">{s.value.name}</strong>}
          />
        </section>
      </Catch>
    </div>
  )
})
