import { Cause, Data, Effect } from "effect"
import { AtomRef } from "effect/unstable/reactivity"
import { Async, asyncRef, Catch, Component } from "@verrex/core"
import { Http, HttpError, type User } from "./services.ts"

/**
 * Demo-local second error tag: the per-tag choice of error home needs ≥2 tags
 * so one can be handled at the leaf while the other rides the residual.
 */
class RateLimited extends Data.TaggedError("RateLimited")<{
  readonly retryAfterMs: number
}> {}

/**
 * `Async` failure homes (step 08) — **the `failure` arm picks where each
 * error lives, per call site and per tag** — now built on **`AsyncHandle`**:
 * each block's data is an `asyncRef` handle (`{ state, refetch }`) created in
 * the component body, OUTSIDE the boundaries, then handed to `Async`. The
 * data outlives the views: an escalated block's fetch loop keeps tracking
 * `userId` and can be refetched from anywhere — the spam button is just
 * `tagUser.refetch()` ×3, no synthetic dep tricks.
 *
 * **Tag-map block** (top): the thunk can fail with `HttpError | RateLimited`.
 * - `HttpError` is handled **at the leaf**: the 404 banner renders in place;
 *   picking another id refetches and recovers with no boundary involved, and
 *   the handler's `retry` (the handle's own `refetch`) re-runs the same
 *   fetch — the `initial` arm shows while it's in flight.
 * - `RateLimited` is *not* in the map, so it rides the residual —
 *   `View<Exclude<HttpError | RateLimited, { _tag: "HttpError" }>>` =
 *   `View<RateLimited>` — to the page-level `Catch`, whose own tag map
 *   unwraps it (`e.retryAfterMs` is typed). Deleting that `Catch` is a
 *   compile error naming `RateLimited`, and only `RateLimited`.
 *
 * **Open-form block** (bottom): the SAME pattern with no `failure` arm —
 * every failure rides `View<HttpError | RateLimited>` to its catch-all
 * `Catch`. Deleting that `Catch` is a compile error naming the full union.
 *
 * **Boundary retries compose `refetch` + `reset`**: over a handle, `reset`
 * alone re-renders the handle's CURRENT state (the data outlives the
 * subtree — a still-failed handle would just re-escalate), so the banners'
 * retry buttons do `() => { handle.refetch(); reset() }`.
 *
 * **The rate limit is real, and the request log narrates it**: a
 * sliding-window limiter on the fake endpoint allows 2 requests/second
 * ACROSS BOTH HANDLES. Every request logs its budget verdict (`sent (n/2
 * this second)` / `→ 429`), its `← 200/404` outcome, and `← interrupted`
 * when a newer refetch took over. Both handles track `userId`, so an id
 * click always costs two requests — watch the log.
 *
 * Inferred type: `Effect<View, never, Http | Scope>`
 */
export const AsyncEscalate = Component.make(function* () {
  const userId = AtomRef.make("42")
  const http = yield* Http

  // The request log: newest line first, capped. A plain reactive text ref —
  // the whole story of the limiter told by the demo itself.
  const reqLog = AtomRef.make("")
  let seq = 0
  const logLine = (line: string): void => {
    reqLog.update((cur) => [line, ...cur.split("\n")].slice(0, 6).join("\n"))
  }

  // Sliding-window rate limiter: at most LIMIT request creations per WINDOW,
  // shared by both handles (it guards the endpoint, not the consumer). Runs in
  // fetchUser's synchronous body — request-creation time — so every refetch
  // (dep change, retry, spam) counts exactly once, interrupted or not.
  const WINDOW_MS = 1000
  const LIMIT = 2
  const stamps: Array<number> = []
  const fetchUser = (id: string): Effect.Effect<User, HttpError | RateLimited> => {
    const now = Date.now()
    while (stamps.length > 0 && now - (stamps[0] ?? now) >= WINDOW_MS) stamps.shift()
    if (stamps.length >= LIMIT) {
      const retryAfterMs = WINDOW_MS - (now - (stamps[0] ?? now))
      logLine(`#${++seq} GET /users/${id} → 429 rate-limited, slot free in ${retryAfterMs}ms`)
      return Effect.fail(new RateLimited({ retryAfterMs }))
    }
    stamps.push(now)
    const n = ++seq
    logLine(`#${n} GET /users/${id} — sent (${stamps.length}/${LIMIT} this second)`)
    return http.getUser(id).pipe(
      Effect.tap((user) => Effect.sync(() => logLine(`#${n} ← 200 ${user.name}`))),
      Effect.tapError((e) => Effect.sync(() => logLine(`#${n} ← ${e.status} ${e.message}`))),
      Effect.onInterrupt(() => Effect.sync(() => logLine(`#${n} ← interrupted (newer request took over)`))),
    )
  }

  // The handles: one fetch loop per block, both tracking userId, both living
  // in the COMPONENT scope — boundaries below swap views, never the data.
  const tagUser = yield* asyncRef(() => fetchUser(userId.value))
  const openUser = yield* asyncRef(() => fetchUser(userId.value))
  // Spam = three manual refetches of the CURRENT id on the top handle: the
  // third (or earlier, right after a click) exceeds 2 req/s → a real 429.
  const spam = () => {
    tagUser.refetch()
    tagUser.refetch()
    tagUser.refetch()
  }

  return yield* (
    <div class="async-escalate">
      <div class="controls">
        <button onclick={() => userId.set("42")}>Ada (42)</button>
        <button onclick={() => userId.set("7")}>Grace (7)</button>
        <button onclick={() => userId.set("999")}>Bad id</button>
        <button class="spam" onclick={spam}>spam ×3</button>
        <span class="budget-note">fake API allows 2 req/s — an id click fetches once per block; spam re-requests the top block</span>
      </div>
      <pre class="req-log">{reqLog}</pre>
      {Catch(
        <section class="content">
          {Async(tagUser, {
            initial: <span class="loading">loading…</span>,
            failure: {
              // Handled at the leaf: the handle stays live, so another id
              // recovers without any reset; `retry` is tagUser.refetch.
              HttpError: (e, retry) => (
                <div class="leaf-fallback">
                  <p class="leaf-msg">handled at the leaf — HttpError {e.status}: {e.message}</p>
                  <button class="leaf-retry" onclick={retry}>retry</button>
                </div>
              ),
            },
            success: (user) => (
              <div class="user-card">
                <strong>{user.name}</strong>
                {user.bio && <p class="bio">{user.bio}</p>}
              </div>
            ),
          })}
        </section>,
        {
          // The residual — View<RateLimited> — lands here, unwrapped + typed.
          // Over a handle, reset alone re-renders the still-failed state:
          // compose refetch + reset so retry re-fetches AND re-renders.
          RateLimited: (e, reset) => (
            <div class="boundary-fallback page-fallback">
              <p class="caught">page boundary caught: RateLimited</p>
              <p class="rate-msg">rate limited — retry in {e.retryAfterMs}ms</p>
              <button class="retry" onclick={() => { tagUser.refetch(); reset() }}>retry</button>
            </div>
          ),
        },
      )}
      <p class="contrast-label">same fetch, open form — no failure arm, every failure escalates:</p>
      {Catch(
        <section class="contrast">
          {Async(openUser, {
            initial: <span class="loading">loading…</span>,
            success: (user) => <strong class="open-ok">{user.name}</strong>,
          })}
        </section>,
        (cause, reset) => (
          <div class="boundary-fallback open-fallback">
            <p class="caught">catch-all caught:</p>
            <pre class="cause">{Cause.pretty(cause)}</pre>
            <button class="retry" onclick={() => { openUser.refetch(); reset() }}>retry</button>
          </div>
        ),
      )}
    </div>
  )
})
