import { Cause, Effect, Exit, Fiber, Layer, Scope } from "effect"
import { AtomRegistry } from "effect/unstable/reactivity"
import { Catch, mount, type View } from "@verrex/core"
import { Counter } from "./Counter.vx"
import { AsyncUserPage } from "./AsyncUserPage.vx"
import { AsyncEscalate } from "./AsyncEscalate.vx"
import { CatchDemo } from "./CatchDemo.vx"
import { Clock } from "./Clock.vx"
import { flashOnUpdate } from "./flash.ts"
import { highlight } from "./highlight.ts"
import { Lifecycle } from "./Lifecycle.vx"
import { LiveUser } from "./LiveUser.vx"
import { Http, HttpLive, Theme, ThemeLive } from "./services.ts"
import { Todos } from "./Todos.vx"
import { SaveButton } from "./SaveButton.vx"
import { TypedHandlers } from "./TypedHandlers.vx"
import { UserPage } from "./UserPage.vx"

const REPO = "https://github.com/m9tdev/verrex"
const SRC = `${REPO}/blob/main/apps/demo/src`

// Each demo is mounted independently (see `setupDemo` below); the refresh
// button recreates it from scratch. `refreshers` maps a demo id to its remount
// fn so the static button in `App` can trigger it.
const refreshers = new Map<string, () => void>()
const teardowns = new Map<string, () => void>()

/**
 * The static left column of a guided-tour section: a step number, the concept
 * the primitive teaches, the *inferred* `Effect<View, E, R>` type, a curated
 * source snippet, and a link to the full file. Pure presentation — folds to
 * `Effect<View, never, never>`.
 */
const copy = (meta: {
  readonly step: string
  readonly title: string
  readonly concept: string
  readonly type: string
  readonly code: string
  readonly file: string
}) => (
  <div class="tour-copy">
    <div class="tour-head">
      <span class="step">{meta.step}</span>
      <h2>{meta.title}</h2>
    </div>
    <p class="concept">{meta.concept}</p>
    <p class="sig-label">inferred type</p>
    <pre class="sig">
      <code>{meta.type}</code>
    </pre>
    <pre class="code">
      <code>
        {highlight(meta.code).map((t) => (
          <span class={`tok-${t.kind}`}>{t.text}</span>
        ))}
      </code>
    </pre>
    <a
      class="src"
      href={`${SRC}/${meta.file}`}
      target="_blank"
      rel="noreferrer"
    >
      view full source ↗
    </a>
  </div>
)

/**
 * The right column: a "live" label, a refresh button that recreates the
 * component (so its initial state — loading spinners, count 0, the original
 * list — can be seen again), and the empty container `setupDemo` mounts into.
 */
const demoSlot = (id: string) => (
  <div class="tour-demo">
    <div class="demo-bar">
      <span class="demo-label">live</span>
      <button
        class="demo-refresh"
        title="recreate this component from scratch"
        onclick={() => refreshers.get(id)?.()}
      >
        ↻ reset
      </button>
    </div>
    <div class="demo-mount" data-demo={id}></div>
  </div>
)

const App = (
  <div class="app">
    <header class="hero">
      <p class="eyebrow">a guided tour</p>
      <h1>verrex</h1>
      <p class="tagline">
        an{" "}
        <a href="https://effect.website" target="_blank" rel="noreferrer">
          Effect
        </a>
        -native UI framework where the <code>{"<A, E, R>"}</code> channels
        survive from every leaf of the view tree to the root. Forget to provide
        a service <code>Layer</code> and you get a{" "}
        <em>compile-time error that names the missing service</em> — not a
        runtime crash.
      </p>
      <div class="how">
        <h3>the trick, in one breath</h3>
        <p>
          TypeScript erases generics at the JSX boundary, collapsing every
          component to <code>JSX.Element</code> — fatal for a framework whose
          point is that <code>E</code>/<code>R</code> survive composition. So
          verrex never lets <code>tsc</code> see JSX: source files use a{" "}
          <code>.vx</code> extension, and <code>verrex/compiler</code> rewrites
          every intrinsic <code>{"<tag/>"}</code> into an{" "}
          <code>h(tag, props, …children)</code> call and every component{" "}
          <code>{"<MyComp/>"}</code> into the direct call{" "}
          <code>{"MyComp({…})"}</code> <em>before</em> tsc parses the file.{" "}
          <code>h()</code>'s conditional-type signature unions every child's{" "}
          <code>E</code> and <code>R</code> into the result — a component's
          channels are just its call's Effect type, and generic components keep
          their type parameter. tsc only ever type-checks plain function calls —
          so the channels can't be erased.
        </p>
        <p class="how-note">
          Every <code>inferred type</code> below is real, checked by{" "}
          <a
            href={`${REPO}/blob/main/apps/demo/src/channels.test-d.ts`}
            target="_blank"
            rel="noreferrer"
          >
            channels.test-d.ts
          </a>
          . Each section pairs the source on the left with the running component
          on the right. Interact with any demo — the brief highlight marks the
          exact DOM node that re-rendered; nothing around it does. Hit{" "}
          <strong>↻ reset</strong> to recreate a component and watch its initial
          state (loading, count 0) from the top.
        </p>
      </div>
    </header>

    <section class="tour">
      {copy({
        step: "01",
        title: "Reactive state",
        concept:
          "Local state is an Effect Atom cell — verrex ships no signal of its own. Writes are Effects (Atom.update), returned straight from the handler. Drop the atom into child position and h() emits a reactive node; on update, only that text node re-renders. No services; the write's AtomRegistry is owned and discharged by mount.",
        type: "Effect<View, never, AtomRegistry>",
        code: `export const Counter = Component.make(function* () {
  const count = Atom.make(0)

  return yield* (
    <div>
      <button onclick={() => Atom.update(count, n => n + 1)}>+</button>
      <span>clicks: {count}</span>
    </div>
  )
})`,
        file: "Counter.vx",
      })}
      {demoSlot("counter")}
    </section>

    <section class="tour">
      {copy({
        step: "02",
        title: "Effectful data (channels fold to root)",
        concept:
          "Fetch inside the component. `yield* Http` adds Http to R; the request can fail, so HttpError rides E. Both surface in the type and must be satisfied at mount — drop HttpLive below and main stops compiling. The subtree blocks until the request resolves.",
        type: "Effect<View, HttpError, Http | Theme>",
        code: `export const UserPage = Component.make(function* (props: {
  userId: string
}) {
  const http = yield* Http        // adds Http to R
  const theme = yield* Theme      // adds Theme to R
  const user = yield* http.getUser(props.userId) // may fail → HttpError in E

  return yield* (
    <article class={theme.mode}>
      <h1>{user.name}</h1>
    </article>
  )
})`,
        file: "UserPage.vx",
      })}
      {demoSlot("userpage")}
    </section>

    <section class="tour">
      {copy({
        step: "03",
        title: "Async data as an atom (non-blocking)",
        concept:
          "Same fetch as an atom: atom(effect) runs it on its own fiber and hands back Atom<AsyncResult<User, HttpError>> — the state of the Effect. A pending placeholder shows immediately; the failure is rendered at the leaf (a function Failure arm), so E is discharged to never. Http still folds into R — a forgotten Layer is still a compile error. AtomRegistry | Scope are the atom's own contribution: it is mounted on the component's Scope, so the fetch is interrupted when that scope closes — here the demo scope, so reset cancels an in-flight fetch. <On value={user} Waiting Success Failure /> renders the states by tag, arms as props: every arm is optional, Waiting wins while a fetch is in flight, and an unhandled failure would bubble by default (View<E>).",
        type: "Effect<View, never, Http | AtomRegistry | Scope>",
        code: `export const AsyncUserPage = Component.make(function* (props: {
  userId: string
}) {
  const http = yield* Http                          // folds into R
  const user = yield* atom(http.getUser(props.userId)) // Atom<AsyncResult>

  return yield* (
    <article>
      <On
        value={user}
        Waiting={() => <p>loading…</p>}
        Success={(s) => <h1>{s.value.name}</h1>}   // s.value: User (inferred)
        Failure={() => <p>failed</p>}              // handled at the leaf
      />
    </article>
  )
})`,
        file: "AsyncUserPage.vx",
      })}
      {demoSlot("async")}
    </section>

    <section class="tour">
      {copy({
        step: "04",
        title: "Async, auto-tracking (deps discovered)",
        concept:
          "The atom's create function reads get(userId), so the id is a tracked dependency and the fetch re-runs whenever it changes — interrupting the stale request. Deps are discovered, not declared: no key array. Pending and failure are AsyncResult values, rendered by tag with <On value={user} Waiting Success Failure /> — every arm optional, Waiting wins while a fetch is in flight, a function Failure handles all failures here. Click the buttons (Atom.set) to refetch.",
        type: "Effect<View, never, Http | AtomRegistry | Scope>",
        code: `export const LiveUser = Component.make(function* () {
  const userId = Atom.make("42")
  const http = yield* Http
  const user = yield* atom((get) => http.getUser(get(userId)))

  return yield* (
    <div>
      <button onclick={() => Atom.set(userId, "7")}>Grace</button>

      <On value={user}
        Waiting={() => <span>loading…</span>}
        Success={(s) => <strong>{s.value.name}</strong>}
        Failure={() => <span>not found</span>}   // a function: handled here → View<never>
      />
    </div>
  )
})
// the create fn reads get(userId) → refetch when it changes`,
        file: "LiveUser.vx",
      })}
      {demoSlot("live")}
    </section>

    <section class="tour">
      {copy({
        step: "05",
        title: "Keyed reactive list",
        concept:
          "A collection where each row is its own AtomRef — the row model. <For each={coll}> renders a keyed View.List node; mount reconciles by ref identity on add/remove. Each row subscribes to its own ref (get(item) in the row's JSX, or item.prop(\"text\")), so toggling one doesn't re-render the rest.",
        type: "Effect<View, never, never>",
        code: `export const Todos = Component.make(function* () {
  const todos = AtomRef.collection<Todo>([
    { text: "build a UI framework", done: true },
    { text: "write a blog post", done: false },
  ])

  return yield* (
    <ul>
      <For each={todos}>
        {(item) => <TodoRow item={item} remove={() => todos.remove(item)} />}
      </For>
    </ul>
  )
})
// → keyed View.List; mount reconciles rows by ref identity
// in TodoRow: <li class={get(item).done ? "done" : ""}>{item.prop("text")}</li>`,
        file: "Todos.vx",
      })}
      {demoSlot("todos")}
    </section>

    <section class="tour">
      {copy({
        step: "06",
        title: "Per-component lifecycle",
        concept:
          "Effect.acquireRelease registers a finalizer against the current Scope, so it rides Row's R — that's the inferred type shown. Each row mounts in its own Scope, so the release fires when that row's DOM is removed, not when the whole app unmounts. <For> supplies each row's Scope, so a parent that renders the list stays Scope-free. Open devtools and watch the __lifecycle log: a paired unmount:N for every mount:N. (Reset closes the demo's scope, firing every remaining row's finalizer at once.)",
        type: "Effect<View, never, Scope>",
        code: `const Row = Component.make(function* (props: {
  item: AtomRef<Item>
}) {
  const id = props.item.value.id
  yield* Effect.acquireRelease(
    Effect.sync(() => log(\`mount:\${id}\`)),
    () => Effect.sync(() => log(\`unmount:\${id}\`)),
  )
  return yield* <li>row {id}</li>
})

// in a parent component — <For> gives each Row its own Scope,
// so the parent's own R stays never:
<ul><For each={items}>{(item) => <Row item={item} />}</For></ul>`,
        file: "Lifecycle.vx",
      })}
      {demoSlot("lifecycle")}
    </section>

    <section class="tour">
      {copy({
        step: "07",
        title: "Error boundary (catch the failure side)",
        concept:
          "Catch mirrors Effect's catch*: recover the failure side of a view subtree, let success pass through. It catches BOTH a failed construction Effect and a post-mount failure inside the live subtree — here the crash button's Effect, which has no E channel to land on and is routed to the boundary instead of dropped. reset re-runs the child's construction. Scope is the boundary's own contribution (it forks its reset/report loop into the enclosing scope). The arms are props, the same shape as On: one prop per error tag (HttpError={…}) narrows the channel by the handled tags; Failure is the catch-all (it gets the full Cause). mount requires every error discharged — a forgotten boundary is a compile error that names it.",
        type: "Effect<View, never, Scope>",
        code: `export const CatchDemo = Component.make(function* () {
  return yield* (
    <section>
      {/* catch-all: a function Failure recovers any failure */}
      <Catch Failure={(cause, reset) => (
        <div class="fallback">
          <pre>{Cause.pretty(cause)}</pre>
          <button onclick={reset}>reset</button>
        </div>
      )}>
        <Crasher />
      </Catch>

      {/* tag-map: route by tag; handler gets the unwrapped error */}
      <Catch HttpError={(e, reset) =>
        <p>HttpError {e.status} <button onclick={reset}>retry</button></p>}>
        <BadRequest />
      </Catch>
    </section>
  )
})`,
        file: "CatchDemo.vx",
      })}
      {demoSlot("boundary")}
    </section>

    <section class="tour">
      {copy({
        step: "08",
        title: "Failure homes: leaf, page, or split by tag",
        concept:
          "Each block's data is an atom — Atom<AsyncResult<User, HttpError | RateLimited>>, created in the component body and rendered by tag with <On value={…}> — so the data outlives the views: an escalated block keeps tracking userId (get(userId) in its create fn), and Atom.refresh works from anywhere (the spam button is literally Atom.refresh(tagUser) ×3). On picks where each error lives: HttpError is handled at the leaf via an HttpError arm (the banner's retry IS Atom.refresh; the Waiting arm shows in flight), while any OTHER failure BUBBLES BY DEFAULT — the residual is typed like catchTag narrows, View<RateLimited> — to the page boundary's tag map, unwrapped (e.retryAfterMs typed). Deleting that Catch names RateLimited, and only RateLimited. The open form below handles nothing at the leaf: EVERY failure rides View<HttpError | RateLimited> to a catch-all. A boundary reset re-renders the atom's CURRENT state without refetching, so the banners compose Atom.refresh + reset. The rate limit is real (2 req/s across both atoms) and the request log narrates every request: budget verdict, outcome, and stale runs interrupted by newer refetches. Hit spam ×3 and watch the third request 429 in the log AND ride to the page banner — your id selection survives.",
        type: "Effect<View, never, Http | AtomRegistry | Scope>",
        code: `// fetchUser: (id) => Effect<User, HttpError | RateLimited, AtomRegistry>
// — a REAL sliding-window limiter: >2 req/s fails with RateLimited

// the atom: data decoupled from the view, refreshable from anywhere
const tagUser = yield* atom((get) => fetchUser(get(userId)))
<button onclick={spam}>spam ×3</button>   // Atom.refresh(tagUser) ×3

<Catch
  // the residual: View<RateLimited> — unwrapped + typed here.
  // reset re-renders CURRENT state; compose refresh + reset:
  RateLimited={(e, reset) =>
    <p>retry in {e.retryAfterMs}ms{" "}
      <button onclick={() => Effect.andThen(Atom.refresh(tagUser), Effect.sync(reset))}>
        retry</button></p>}
>
  <section>
    <On value={tagUser}
      Waiting={() => <span>loading…</span>}
      Success={(s) => <strong>{s.value.name}</strong>}
      // handled at the leaf — retry IS Atom.refresh(tagUser);
      // any OTHER failure (RateLimited) bubbles: View<RateLimited>
      HttpError={() =>
        <p>404 <button onclick={() => Atom.refresh(tagUser)}>retry</button></p>}
    />
  </section>
</Catch>`,
        file: "AsyncEscalate.vx",
      })}
      {demoSlot("escalate")}
    </section>

    <section class="tour">
      {copy({
        step: "09",
        title: "Typed event handlers (the live channel)",
        concept:
          "Handlers are where most live errors are born — the element is already rendered when one runs, so a failure has no construction E to ride. An onclick returning Effect<_, E, R> stamps E on the element's LIVE channel (View<E>) and folds R into its requirements. This component never yields Http in its body: the handler alone puts Http in R (drop HttpLive from the root Layer and the build names Http), and load #999's 404 rides View<HttpError> — delete the Catch and mount stops compiling, naming HttpError. reset re-runs construction, so the card comes back fresh.",
        type: "Effect<View<HttpError>, never, Http | AtomRegistry>",
        code: `const Loader = Component.make(function* () {
  const loaded = Atom.make("nobody yet")

  // no \`yield* Http\` in the body — the HANDLER carries the channels
  const load = Effect.fn(function* (id: string) {
    const http = yield* Http              // handler R → element R
    const user = yield* http.getUser(id)  // may 404 → HttpError, LIVE
    yield* Atom.set(loaded, user.name)    // registry write → R too
  })

  return yield* (
    <div>
      <p>loaded: <strong>{loaded}</strong></p>
      <button onclick={() => load("42")}>load Ada</button>
      <button onclick={() => load("999")}>load #999</button>
    </div>
  )
})
// Loader: Effect<View<HttpError>, never, Http | AtomRegistry> — the
// failing click must meet a Catch before mount, which names it otherwise:

<Catch HttpError={(e, reset) =>
  <p>HttpError {e.status} <button onclick={reset}>reset</button></p>}>
  <Loader />
</Catch>`,
        file: "TypedHandlers.vx",
      })}
      {demoSlot("handlers")}
      {copy({
        step: "10",
        title: "Pending → run → settle (the state of a function call)",
        concept:
          "The standard mutation pattern, as fn: save(id) runs the body on the fn's own fiber and get(save) is its AsyncResult. Waiting swaps the buttons for a spinner — the clicked element is gone while the 600ms Http call runs — and success settles back to the buttons (saved += 1). The fn is mounted on the component's Scope: tear it down (↻ reset while saving) and the in-flight call is interrupted — no leak, no stale write. save (fails) shows the corollary: On has no Failure arm, so the failure bubbles by default — the typed HttpError rides the live channel to the Catch. The fn's R (Http) rides the component like any atom's.",
        type: "Effect<View<HttpError>, never, Http | AtomRegistry | Scope>",
        code: `const Saver = Component.make(function* () {
  const saved = Atom.make(0)

  const save = yield* fn((id: string) => Effect.gen(function* () {
    const http = yield* Http             // fn R → component R
    yield* http.getUser(id)              // 600ms; #999 → HttpError
    yield* Atom.update(saved, n => n + 1)
  }))

  return yield* (
    <div>
      <p>saved: <strong>{saved}</strong></p>
      <On
        value={save}
        Waiting={() => <span>saving…</span>}   // hides THIS button
        Initial={() => <button onclick={() => save("42")}>save</button>}
        Success={() => <button onclick={() => save("42")}>save</button>}
        // no Failure arm: HttpError bubbles → live → Catch
      />
    </div>
  )
})`,
        file: "SaveButton.vx",
      })}
      {demoSlot("savebutton")}
      {copy({
        step: "11",
        title: "Streams (push-based, fine-grained)",
        concept:
          "An Effect Stream drives an analog clock through atom(stream) — the same primitive as atom(effect), fed by a stream: the stream is the current time once a second (Stream.tick mapped to new Date()), and the atom runs it on its own fiber, updating an Atom<AsyncResult<Date>> per emission. No manual fork, no unsubscribe bookkeeping: the fiber dies with the component's Scope (↻ reset, watch it freeze — the same mechanism as step 06), and a service-needing stream would fold its R into the component, like every other primitive here. The fine-grained part is derivation: each hand angle is an Atom.map(…) — a derived atom that recomputes on every tick but notifies only when ITS value changed — and each hand's style is a get(...) reader over exactly its own derived atom. A tick re-renders ONE DOM attribute — watch the flash hit only the second hand, exactly on the second, with the other hands joining at the top of the minute.",
        type: "Effect<View, never, AtomRegistry | Scope>",
        code: `export const Clock = Component.make(function* () {
  // stream → Atom<AsyncResult<Date>>; the fiber dies with the component's Scope
  const now = yield* atom(
    Stream.tick("1 second").pipe(Stream.map(() => new Date())),
  )
  const date = Atom.map(now, (r) => AsyncResult.getOrElse(r, () => new Date()))

  // derived atoms: recompute every tick, notify only on change
  const second = Atom.map(date, (d) => d.getSeconds() * 6)
  const minute = Atom.map(date, (d) => d.getMinutes() * 6)
  const hour = Atom.map(date, (d) => (d.getHours() % 12) * 30 + d.getMinutes() * 0.5)

  return yield* (
    <div class="aclock">
      <div class="hand hour"   style={\`transform: rotate(\${get(hour)}deg)\`} />
      <div class="hand minute" style={\`transform: rotate(\${get(minute)}deg)\`} />
      <div class="hand second" style={\`transform: rotate(\${get(second)}deg)\`} />
    </div>
  )
})`,
        file: "Clock.vx",
      })}
      {demoSlot("clock")}
    </section>

    <footer class="site-footer">
      <p>
        verrex is an experimental proof-of-concept.{" "}
        <a href={REPO} target="_blank" rel="noreferrer">
          source on GitHub ↗
        </a>
      </p>
    </footer>
  </div>
)

const rootEl = document.getElementById("root")
if (!rootEl) throw new Error("missing #root")

// The full app Layer. Every demo's requirements must be a subset of what this
// provides — `setupDemo`'s signature enforces it, so forgetting (say) HttpLive
// is a compile error at the UserPage/AsyncUserPage/LiveUser call sites, not a
// runtime crash. That's the thesis, now enforced per-mount.
const APP_LAYER = Layer.mergeAll(HttpLive, ThemeLive)

// Everything the demos may require, after HttpLive/ThemeLive: the reactivity
// registry (every `atom`/`fn`/`Atom.set` needs it; discharged by `mount`, which
// owns it), the two services, and a Scope.
type DemoR = AtomRegistry.AtomRegistry | Http | Theme | Scope.Scope

/**
 * Mount a component into its demo container under a Closeable scope we own, and
 * register a `remount` that tears the old one down (firing its finalizers,
 * cancelling in-flight Async fetches) and builds a fresh one. Because `make()`
 * is called anew each time, refresh shows the component's initial state again.
 *
 * `make`'s `R` is constrained to `DemoR`, so a component needing a service
 * APP_LAYER doesn't provide won't type-check here.
 */
const setupDemo = <E,>(
  id: string,
  make: () => Effect.Effect<View, E, DemoR>,
): void => {
  const container = rootEl.querySelector<HTMLElement>(`[data-demo="${id}"]`)
  if (!container) throw new Error(`missing demo container: ${id}`)

  let teardown: (() => void) | null = null
  const remount = (): void => {
    teardown?.()
    const scope = Scope.makeUnsafe()
    // `mount` requires a discharged app. Wrap every demo in a `Catch`
    // boundary so any error (construction or live) becomes a visible fallback
    // instead of a compile error here — and to discharge the `E` channel uniformly
    // (UserPage carries HttpError). The happy paths don't fail, so they render
    // through unchanged; this is also where the boundary itself gets exercised.
    // Build APP_LAYER INTO the demo's scope (not `Effect.provide`, which scopes
    // it to the mount effect — an effect that completes once the DOM attaches).
    // The AtomRegistry needs no layer: `mount` owns one per mount and disposes
    // it with the same scope close that detaches the DOM (every atom is mounted
    // on this scope, so reset interrupts in-flight fetches and fn calls).
    Effect.runFork(
      Scope.provide(
        Effect.flatMap(Layer.build(APP_LAYER), (ctx) =>
          mount(
            <Catch
              Failure={(cause) => (
                <div class="demo-error">
                  <strong>this demo failed:</strong>
                  <pre>{Cause.pretty(cause)}</pre>
                </div>
              )}
            >
              {make()}
            </Catch>,

            container,
          ).pipe(
            Effect.catchCause((cause) =>
              Effect.sync(() =>
                console.error(`[verrex demo: ${id}]`, Cause.pretty(cause)),
              ),
            ),
            Effect.provideContext(ctx),
          ),
        ),
        scope,
      ),
    )
    teardown = () => {
      const closing = Scope.closeUnsafe(scope, Exit.void)
      if (closing) Effect.runFork(closing)
    }
  }

  refreshers.set(id, remount)
  teardowns.set(id, () => teardown?.())
  remount()
}

const program = Effect.gen(function* () {
  yield* mount(App, rootEl)
  yield* Effect.sync(() => {
    setupDemo("counter", () => Counter())
    setupDemo("userpage", () => UserPage({ userId: "42" }))
    setupDemo("async", () => AsyncUserPage({ userId: "42" }))
    setupDemo("live", () => LiveUser())
    setupDemo("todos", () => Todos())
    setupDemo("lifecycle", () => Lifecycle())
    setupDemo("boundary", () => CatchDemo())
    setupDemo("escalate", () => AsyncEscalate())
    setupDemo("handlers", () => TypedHandlers())
    setupDemo("savebutton", () => SaveButton())
    setupDemo("clock", () => Clock())
  })
  // Start the reactivity flash once the initial mounts settle (incl. the
  // simulated fetch latency), so only interactions and resets flash — not page
  // load. Keep this comfortably past the latency in services.ts.
  yield* Effect.sleep("900 millis")
  yield* Effect.sync(() => flashOnUpdate(rootEl))
  // Keep App's scope alive so the refresh buttons' listeners persist.
  yield* Effect.never
}).pipe(
  Effect.scoped,
  Effect.catchCause((cause) =>
    Effect.sync(() => {
      console.error("App failed:", Cause.pretty(cause))
    }),
  ),
  Effect.provide(APP_LAYER),
)

const fiber = Effect.runFork(program)

// Test affordance: scripts/probe-lifecycle.mjs calls this to trigger a full
// teardown. Closing each demo's scope cascades through every per-row /
// per-Reactive sub-scope and fires their finalizers; interrupting the App
// fiber tears down the static shell.
;(globalThis as { __teardown?: () => void }).__teardown = () => {
  for (const close of teardowns.values()) close()
  Effect.runFork(Fiber.interrupt(fiber))
}
