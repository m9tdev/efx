import { Cause } from "effect"
import { Async, Component } from "@verrex/core"
import { Http } from "./services.ts"

/**
 * The async leaf, errors-as-values style.
 *
 * `Async(from, { initial, failure, success })` runs `from` on the mount fiber —
 * so `Http` folds into `R` (a forgotten Layer is still a compile error) and
 * `Scope` is borrowed for cancellation — and renders the three `AsyncResult`
 * states. `from` is a thunk, so it can be extracted (`getUser` below); a ref
 * read inside it auto-refetches. Thunk-first positional so `success`'s `user`
 * infers as `User`. Failure renders via `failure`, handled as a value — never
 * thrown, never folded to `E`.
 *
 * (The compiler will lower `<Async from initial failure success/>` to this call;
 * here it's written out so the prototype needs no compiler change yet.)
 *
 * Inferred type: `Effect<View, never, Http | Scope>`
 */
export const AsyncUserPage = Component.make(function* (props: { userId: string }) {
  const http = yield* Http
  const getUser = () => http.getUser(props.userId)

  return yield* (
    <article class="async-user-page">
      {Async(getUser, {
        initial: <p class="loading">  loading user…</p>,
        failure: (cause) => <p class="error">error: {Cause.pretty(cause)}</p>,
        success: (user) => (
          <div class="user-body">
            <h1>{user.name}</h1>
            {user.bio && <p class="bio">{user.bio}</p>}
            {user.posts.length > 0 ? (
              <ul class="posts">
                {user.posts.map((p) => (
                  <li data-post-id={p.id}>{p.title}</li>
                ))}
              </ul>
            ) : (
              <p class="empty">No posts yet.</p>
            )}
          </div>
        ),
      })}
    </article>
  )
})
