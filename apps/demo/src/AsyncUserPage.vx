import { Cause } from "effect"
import { AsyncResult } from "effect/unstable/reactivity"
import { atom, Component } from "@verrex/core"
import { Http } from "./services.ts"

/**
 * The async leaf, errors-as-values style.
 *
 * `atom(effect)` runs the fetch on its own fiber and hands back an
 * `Atom<AsyncResult<User, HttpError>>` — the state of the Effect. `Http` is
 * extracted in the component body, so it folds into `R` (a forgotten Layer
 * is still a compile error); `AtomRegistry | Scope` are the atom's own
 * contribution (mounted on the component's Scope, so ↻ reset interrupts an
 * in-flight fetch). `AsyncResult.builder(get(user))` renders the three
 * states as values; `.onFailure` handles the failure at the leaf — never
 * thrown, never folded to `E` — and `exhaustive()` type-checks that every
 * case is covered.
 *
 * Inferred type: `Effect<View, never, Http | AtomRegistry | Scope>`
 */
export const AsyncUserPage = Component.make(function* (props: {
  userId: string
}) {
  const http = yield* Http
  const user = yield* atom(http.getUser(props.userId))

  return yield* (
    <article class="async-user-page">
      {AsyncResult.builder(get(user))
        .onInitialOrWaiting(() => <p class="loading"> loading user…</p>)
        .onSuccess((user) => (
          <div class="user-body">
            <h1>{user.name}</h1>
            {user.bio && <p class="bio">{user.bio}</p>}
            {user.posts.length > 0 ? (
              <ul class="posts">
                {user.posts.map((p) => (
                  <li data-post-id={p.id}>{p.title}</li>
                ))}
              </ul>
            ) : (
              <p class="empty">No posts yet.</p>
            )}
          </div>
        ))
        .onFailure((cause) => <p class="error">error: {Cause.pretty(cause)}</p>)
        .exhaustive()}
    </article>
  )
})
