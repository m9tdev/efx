import { Cause } from "effect"
import { AtomRef } from "effect/unstable/reactivity"
import { Async, Component } from "@verrex/core"
import { Http } from "./services.ts"

/**
 * Live, reactive async data via `Async`, auto-tracking form.
 *
 * The user id is local writable state (`AtomRef`); the buttons set it. The
 * `Async` thunk reads `userId.value`, so it becomes a tracked dependency and the
 * fetch re-runs whenever the id changes — interrupting the stale request and
 * rendering initial/success/failure. No explicit trigger to declare. The arms
 * are thunk-first positional, so `success`'s `user` infers as `User`.
 *
 * Inferred type: `Effect<View, never, Http | Scope>`
 *   — the service is extracted up front (`const http = yield* Http`), so `Http`
 *   folds into the component's `R` and is provided at `mount`; the fetch runs on
 *   the mount fiber, not a baked `Atom.runtime`. Forgetting the `Http` layer is
 *   a compile error, not a runtime failure.
 */
export const LiveUser = Component.make(function* () {
  const userId = AtomRef.make("42")
  const http = yield* Http

  return yield* (
    <div class="live-user">
      <h3>Async data via Async (live, reactive, channels intact)</h3>
      <div class="controls">
        <button onclick={() => userId.set("42")}>Ada (42)</button>
        <button onclick={() => userId.set("7")}>Grace (7)</button>
        <button onclick={() => userId.set("999")}>Bad id</button>
      </div>
      {Async(() => http.getUser(userId.value), {
        initial: <span class="loading">  loading…</span>,
        failure: (cause) => (
          <span class="error">error: {Cause.pretty(cause)}</span>
        ),
        success: (user) => (
          <div class="user-card">
            <strong>{user.name}</strong>
            {user.bio && <p class="bio">{user.bio}</p>}
          </div>
        ),
      })}
    </div>
  )
})
