import { Effect } from "effect"
import { AtomRef } from "effect/unstable/reactivity"
import { h } from "@effx/runtime"

/**
 * Small reactive component using `AtomRef` for local state.
 *
 * The `count` ref is interpolated directly as a child — `h()` emits a
 * `View.Reactive` IR node when it sees an `AtomRef` in child position.
 * On `count.update`, only the surrounding text node re-renders.
 *
 * Inferred type: `Effect<View, never, never>`
 *   — `AtomRegistry` is mount's concern, not the component's.
 */
export const Counter = Effect.fn("Counter")(function* () {
  const count = AtomRef.make(0)

  return yield* (
    <div class="counter">
      <button onclick={() => count.update((n) => n + 1)}>+</button>
      <span class="count"> clicks: {count} </span>
      <button onclick={() => count.set(0)}>reset</button>
    </div>
  )
})
