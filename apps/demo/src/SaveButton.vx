import { Effect } from "effect"
import { Atom } from "effect/unstable/reactivity"
import { Catch, Component, fn, On } from "@verrex/core"
import { Http } from "./services.ts"

// #160/#161: the pending → run → settle mutation pattern, as `fn` — the
// state of a function call. `save(id)` runs the body on the fn's own fiber
// (mounted on the component's Scope, so ↻ reset mid-flight interrupts it —
// no leak, no stale write); `get(save)` is its `AsyncResult`: waiting swaps
// the buttons for a spinner — the very element the click came from is gone
// while the (600ms) Http call runs — success settles back to the buttons, and
// a failure is escalated (`.onFailure(Effect.failCause)`) so the typed
// HttpError rides the LIVE channel to the `Catch`.
//
//   Saver : Effect<View<HttpError>, never, Http | AtomRegistry | Scope>
const Saver = Component.make(function* () {
  const saved = Atom.make(0)

  const save = yield* fn((id: string) =>
    Effect.gen(function* () {
      const http = yield* Http
      yield* http.getUser(id) // 600ms; #999 → HttpError
      yield* Atom.update(saved, (n) => n + 1)
    }),
  )

  const buttons = (
    <span>
      <button class="save" onclick={() => save("42")}>
        save
      </button>{" "}
      <button class="save-fail" onclick={() => save("999")}>
        save (fails)
      </button>
    </span>
  )

  return yield* (
    <div class="save-button">
      <p>
        saved: <strong class="saved">{saved}</strong>
      </p>
      <On
        value={save}
        Waiting={() => <span class="saving">saving…</span>}
        // Initial and Success (settled) both show the buttons; a failure has
        // no arm here → HttpError bubbles (live channel) to the Catch.
        Initial={() => buttons}
        Success={() => buttons}
      />
    </div>
  )
})

/** The discharged wrapper the demo mounts — mirrors step 09's Catch form. */
export const SaveButton = Component.make(function* () {
  return yield* Catch(<Saver />, {
    HttpError: (e, reset) => (
      <div class="boundary-fallback">
        <p class="caught">
          save failed after the re-render: HttpError {e.status} — {e.message}
        </p>
        <button class="reset" onclick={reset}>
          reset
        </button>
      </div>
    ),
  })
})
