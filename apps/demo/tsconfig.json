{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "@verrex/ts-plugin" }]
  },
  // `.vx` sources go through `@verrex/ts-plugin` (editor) or
  // `verrex/check` (CLI); `.ts` files like `channels.test-d.ts` go
  // through the standard tsc path. Both must be included.
  "include": ["src/**/*.ts", "src/**/*.vx"]
}
